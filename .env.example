# URL base del backend (Next.js + Supabase API). Sin barra final.
# Dev: el backend corre en :3000, el admin en :3001.
NEXT_PUBLIC_API_BASE_URL=https://backend.skipfee.co

# Google Maps JS API key (browser-exposed por diseño; restríngela por HTTP referrer).
# Distinta de la GOOGLE_MAPS_API_KEY server-side del backend. Sin ella, los mapas
# de rutas/zonas muestran un placeholder; el resto de la app funciona.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# WhatsApp de soporte (solo dígitos, con indicativo: 573001234567).
# Si está vacío, Primeros pasos no muestra el carril de ayuda humana.
NEXT_PUBLIC_SOPORTE_WHATSAPP=
